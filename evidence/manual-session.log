$ cat nginx/default.conf.template
server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location / { try_files $uri $uri/ =404; }
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}

